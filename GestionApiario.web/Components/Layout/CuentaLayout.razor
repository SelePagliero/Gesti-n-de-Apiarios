@inherits LayoutComponentBase

@* Layout de las pantallas de ingreso y registro: una tarjeta centrada sobre el fondo crema, sin menú lateral. *@
<div class="cuenta-fondo">
    <div class="cuenta-contenido">
        <div class="cuenta-marca">
            <span class="cuenta-logo" aria-hidden="true"><i class="bi bi-hexagon"></i></span>
            <span class="cuenta-nombre">Gestión de Apiarios</span>
        </div>
        <div class="cuenta-tarjeta card">
            <div class="card-body">
                @Body
            </div>
        </div>
    </div>
</div>

<div id="blazor-error-ui">
    Ocurrió un error inesperado.
    <a href="" class="reload">Recargar</a>
    <a class="dismiss">🗙</a>
</div>
