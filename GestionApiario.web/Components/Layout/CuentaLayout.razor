@inherits LayoutComponentBase

@* Layout de las pantallas de ingreso y registro: sin menú lateral. *@
<div class="cuenta-fondo">
    <div class="cuenta-tarjeta card shadow">
        <div class="card-body p-4">
            <div class="text-center mb-4">
                <img src="icons8-farming-96.png" alt="" width="64" height="64" />
                <h4 class="mt-2 mb-0">Gestión de Apiarios</h4>
            </div>
            @Body
        </div>
    </div>
</div>

<div id="blazor-error-ui">
    Ocurrió un error inesperado.
    <a href="" class="reload">Recargar</a>
    <a class="dismiss">🗙</a>
</div>
