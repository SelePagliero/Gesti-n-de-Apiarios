@page "/crear-producto"
@page "/actualizar-producto/{codigo:int}"
@inject IApiariosServicio _servicio
@inject NavigationManager _navegationmanager

<PageTitle>Producto</PageTitle>

@if (Codigo is null)
{
    <h3>Crear Producto</h3>
}
else
{
    <h3>Actualizar Producto</h3>
}

<MensajeError Mensaje="@mensajeError" />

<EditForm Model="Producto" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label for="nombre" class="form-label">Nombre</label>
        <InputText class="form-control" id="nombre" @bind-Value="Producto.Nombre" />
        <ValidationMessage For="() => Producto.Nombre" />
    </div>
    <a href="/productos" class="btn btn-secondary">Volver</a>
    <button type="submit" class="btn btn-primary">Guardar</button>
</EditForm>

@code {
    [Parameter]
    public int? Codigo { get; set; }
    public ProductoDto Producto { get; set; } = new ProductoDto();
    string? mensajeError;

    protected async Task HandleSubmit()
    {
        mensajeError = null;
        try
        {
            if (Codigo is null)
            {
                await _servicio.CrearProducto(Producto);
            }
            else
            {
                await _servicio.ModificarProducto(Codigo.Value, Producto);
            }
        }
        catch (HttpRequestException ex)
        {
            mensajeError = ex.Message;
            return;
        }

        _navegationmanager.NavigateTo("/productos");
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Codigo.HasValue)
        {
            var productoDetalle = await _servicio.ObtenerProducto(Codigo.Value);
            Producto = new()
            {
                Nombre = productoDetalle.Nombre ?? string.Empty
            };
        }
    }
}
