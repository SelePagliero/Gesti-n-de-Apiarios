@page "/productos"
@inject IApiariosServicio _servicio
@inject IJSRuntime JS

<PageTitle>Productos</PageTitle>

<h1>Productos</h1>

<MensajeError Mensaje="@mensajeError" />

@if (productos == null)
{
    <p><em>Cargando...</em></p>
}
else
{
    @if (esAdministrador)
    {
        <a href="/crear-producto" class="btn btn-primary mb-3"><i class="bi bi-plus-circle"></i> Crear Producto</a>
    }

    @if (productos.Count == 0)
    {
        <p class="text-muted">Todavía no hay productos cargados.</p>
    }
    else
    {
        <table class="table table-striped">
            <thead>
                <tr>
                    <th>Código</th>
                    <th>Nombre</th>
                    <th>Fecha de alta</th>
                    <th>Fecha de modificación</th>
                    @if (esAdministrador)
                    {
                        <th>Acciones</th>
                    }
                </tr>
            </thead>
            <tbody>
                @foreach (var producto in productos)
                {
                    <tr>
                        <td>@producto.Codigo</td>
                        <td>@producto.Nombre</td>
                        <td>@producto.FechaAlta?.ToString("g")</td>
                        <td>@((producto.FechaModificacion ?? producto.FechaAlta)?.ToString("g"))</td>
                        @if (esAdministrador)
                        {
                            <td>
                                <a href="/actualizar-producto/@producto.Codigo" class="btn btn-dark"><i class="bi bi-pencil-square"></i> Editar</a>
                                <button type="button" @onclick="() => EliminarProducto(producto)" class="btn btn-danger"><i class="bi bi-trash"></i> Eliminar</button>
                            </td>
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
}

@code {
    List<ProductoGrillaDto>? productos = null;
    string? mensajeError;
    bool esAdministrador;

    [CascadingParameter]
    Task<AuthenticationState>? Autenticacion { get; set; }

    protected override async Task OnInitializedAsync()
    {
        esAdministrador = await Autenticacion.EsAdministradorAsync();
        await CargarProductos();
    }

    async Task EliminarProducto(ProductoGrillaDto producto)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar el producto \"{producto.Nombre}\"?"))
            return;

        mensajeError = null;
        try
        {
            await _servicio.EliminarProducto(producto.Codigo);
            await CargarProductos();
        }
        catch (HttpRequestException ex)
        {
            mensajeError = ex.Message;
        }
    }

    async Task CargarProductos()
    {
        productos = await _servicio.ObtenerTodosProductos();
    }
}
