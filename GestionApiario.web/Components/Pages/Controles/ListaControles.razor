@page "/controles"
@using GestionApiario.compartido.Dto
@using GestionApiario.web.Servicios.Interfaces
@inject IApiariosServicio _servicio;
@inject NavigationManager _navegationmanager;

@rendermode InteractiveServer

<PageTitle>Controles</PageTitle>

<h1>Controles</h1>

@if (Controles == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <a href="/crear-control" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Crear Control</a>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Código</th>
                <th>Campaña</th>
                <th>Apiario</th>
                <th>Fecha</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var Control in Controles)
            {
                <tr>
                    <td>@Control.Codigo</td>
                    <td>@Control.Campaña</td>
                    <td>@Control.Apiario</td>
                    <td>@Control.Fecha</td>
                    <td>
                        <a href="/ver-Control/@Control.Codigo" class="btn btn-success"><i class="bi bi-eye"></i>Ver</a>
                        <a href="/actualizar-Control/@Control.Codigo" class="btn btn-dark"><i class="bi bi-pencil-square"></i>Editar</a>
                        <button onclick="@(() => EliminarControl(@Control.Codigo))" class="btn btn-danger"><i class="bi bi-trash"></i>Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    List<ControlGrillaDto>? Controles = null;

    protected override async Task OnInitializedAsync()
    {
        await CargarControles();
    }

    async Task EliminarControl(int codigo)
    {
        await _servicio.EliminarControl(codigo);
        _navegationmanager.Refresh(true);
    }

    async Task CargarControles()
    {
        Controles = await _servicio.ObtenerTodosControles();
    }
}
