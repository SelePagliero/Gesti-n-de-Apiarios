@page "/crear-control"
@page "/actualizar-control/{codigo:int}"
@page "/ver-control/{codigo:int}"
@inject IApiariosServicio _servicio
@inject NavigationManager _navegationmanager

@{
    bool EsSoloLectura = _navegationmanager.Uri.Contains("/ver-control", StringComparison.OrdinalIgnoreCase);
}

<PageTitle>Control</PageTitle>

@if (EsSoloLectura)
{
    <h3>Ver Control</h3>
}
else if (Codigo is null)
{
    <h3>Crear Control</h3>
}
else
{
    <h3>Actualizar Control</h3>
}

<MensajeError Mensaje="@mensajeError" />

<EditForm Model="Control" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <div class="container">
        <div class="row">
            <!-- Primera columna -->
            <div class="col-12 col-md-6">
                <div class="mb-3">
                    <label for="selectCampaña" class="form-label">Campaña</label>
                    <InputSelect id="selectCampaña" class="form-select" @bind-Value="Control.CodCampaña" disabled="@EsSoloLectura">
                        <option value="0">Seleccione una Campaña</option>
                        @foreach (var campaña in CampañasDisponibles)
                        {
                            <option value="@campaña.Codigo">@TextoCampaña(campaña)</option>
                        }
                        @if (Control.CodCampaña != 0 && CampañasDisponibles.All(c => c.Codigo != Control.CodCampaña))
                        {
                            <option value="@Control.CodCampaña">(campaña de otro apicultor: elegí otra)</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Control.CodCampaña" />
                </div>
                <div class="mb-3">
                    <label for="fecha" class="form-label">Fecha</label>
                    <InputDate class="form-control" id="fecha" @bind-Value="Control.Fecha" disabled="@EsSoloLectura" />
                </div>
                <div class="mb-3">
                    <label for="selectApiario" class="form-label">Apiario</label>
                    <InputSelect id="selectApiario" class="form-select" @bind-Value="Control.CodApiario" disabled="@EsSoloLectura">
                        <option value="0">Seleccione un Apiario</option>
                        @foreach (var apiario in listaDeApiarios)
                        {
                            <option value="@apiario.Codigo">@apiario.Nombre@(esAdministrador ? $" ({apiario.Apicultor})" : "")</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => Control.CodApiario" />
                </div>
                <div class="mb-3">
                    <label for="cantColmenas" class="form-label">Cantidad de Colmenas</label>
                    <InputNumber class="form-control" id="cantColmenas" @bind-Value="Control.CantDeColmenas" disabled="@EsSoloLectura" />
                    <ValidationMessage For="() => Control.CantDeColmenas" />
                </div>
                <div class="mb-3">
                    <label for="selectAlimentos" class="form-label">Alimento</label>
                    <InputSelect id="selectAlimentos" class="form-select" @bind-Value="Control.CodAlimento" disabled="@EsSoloLectura">
                        <option value="0">Sin alimento</option>
                        @foreach (var alimento in listaDeAlimentos)
                        {
                            <option value="@alimento.Codigo">@alimento.Nombre</option>
                        }
                    </InputSelect>
                </div>
                <div class="mb-3">
                    <label for="cantAlimento" class="form-label">Cantidad de Alimento</label>
                    <InputNumber class="form-control" id="cantAlimento" @bind-Value="Control.CantidadAlimento" disabled="@(EsSoloLectura || Control.CodAlimento == 0)" />
                    <ValidationMessage For="() => Control.CantidadAlimento" />
                </div>
            </div>
            <!-- Segunda columna -->
            <div class="col-12 col-md-6">
                <div class="mb-3">
                    <label for="selectEnfermedad" class="form-label">Enfermedad</label>
                    <InputSelect id="selectEnfermedad" class="form-select" @bind-Value="Control.CodEnfermedad" disabled="@EsSoloLectura">
                        <option value="0">Sin enfermedad</option>
                        @foreach (var enfermedad in listaDeEnfermedades)
                        {
                            <option value="@enfermedad.Codigo">@enfermedad.Nombre</option>
                        }
                    </InputSelect>
                </div>
                <div class="mb-3">
                    <label for="selectProducto" class="form-label">Producto</label>
                    <InputSelect id="selectProducto" class="form-select" @bind-Value="Control.CodProductos" disabled="@EsSoloLectura">
                        <option value="0">Sin producto</option>
                        @foreach (var producto in listaDeProductos)
                        {
                            <option value="@producto.Codigo">@producto.Nombre</option>
                        }
                    </InputSelect>
                </div>
                <div class="mb-3">
                    <label for="cantProducto" class="form-label">Cantidad de Producto</label>
                    <InputNumber class="form-control" id="cantProducto" @bind-Value="Control.CantProducto" disabled="@(EsSoloLectura || Control.CodProductos == 0)" />
                    <ValidationMessage For="() => Control.CantProducto" />
                </div>
                <div class="mb-3">
                    <label for="observaciones" class="form-label">Observaciones</label>
                    <InputTextArea class="form-control" id="observaciones" rows="3" @bind-Value="Control.Observaciones" disabled="@EsSoloLectura" />
                    <ValidationMessage For="() => Control.Observaciones" />
                </div>
                <div class="text-end">
                    <a href="@UrlVolver" class="btn btn-secondary">Volver</a>
                    @if (!EsSoloLectura)
                    {
                        <button type="submit" class="btn btn-primary">Guardar</button>
                    }
                </div>
            </div>
        </div>
    </div>
</EditForm>

@code {
    [Parameter]
    public int? Codigo { get; set; }

    // Lista de controles (con sus filtros) a la que hay que volver, por ejemplo "controles?apiario=3".
    [SupplyParameterFromQuery(Name = "volver")]
    public string? Volver { get; set; }

    // Solo se acepta volver a la lista de controles, nunca a otra dirección.
    private string UrlVolver =>
        Volver is not null && !Volver.Contains("//")
        && (Volver.Equals("controles", StringComparison.OrdinalIgnoreCase) || Volver.StartsWith("controles?", StringComparison.OrdinalIgnoreCase))
            ? "/" + Volver
            : "/controles";
    public ControlDto Control { get; set; } = new ControlDto();
    List<CampañaGrillaDto> listaDeCampañas = new();

    // Un control solo puede usar campañas del dueño de su apiario. Un apicultor ya recibe solo las suyas;
    // la Administradora ve las del dueño del apiario elegido (o todas, mientras no elija apiario).
    private IEnumerable<CampañaGrillaDto> CampañasDisponibles
    {
        get
        {
            var apiario = listaDeApiarios.FirstOrDefault(a => a.Codigo == Control.CodApiario);
            return esAdministrador && apiario is not null
                ? listaDeCampañas.Where(c => c.UsuarioId == apiario.UsuarioId)
                : listaDeCampañas;
        }
    }

    private string TextoCampaña(CampañaGrillaDto campaña)
    {
        var texto = string.IsNullOrEmpty(campaña.Responsable) ? $"{campaña.Año}" : $"{campaña.Año} - {campaña.Responsable}";
        return esAdministrador && Control.CodApiario == 0 ? $"{texto} ({campaña.Apicultor})" : texto;
    }
    List<ProductoGrillaDto> listaDeProductos = new();
    List<AlimentoGrillaDto> listaDeAlimentos = new();
    List<EnfermedadGrillaDto> listaDeEnfermedades = new();
    List<ApiarioGrillaDto> listaDeApiarios = new();
    string? mensajeError;
    bool esAdministrador;

    [CascadingParameter]
    Task<AuthenticationState>? Autenticacion { get; set; }

    protected async Task HandleSubmit()
    {
        mensajeError = null;
        try
        {
            if (Codigo is null)
            {
                await _servicio.CrearControl(Control);
            }
            else
            {
                await _servicio.ModificarControl(Codigo.Value, Control);
            }
        }
        catch (HttpRequestException ex)
        {
            mensajeError = ex.Message;
            return;
        }

        _navegationmanager.NavigateTo(UrlVolver);
    }

    protected override async Task OnInitializedAsync()
    {
        esAdministrador = await Autenticacion.EsAdministradorAsync();
        listaDeCampañas = await _servicio.ObtenerTodasCampañas();
        listaDeApiarios = await _servicio.ObtenerTodosApiarios();
        listaDeAlimentos = await _servicio.ObtenerTodosAlimentos();
        listaDeEnfermedades = await _servicio.ObtenerTodasEnfermedades();
        listaDeProductos = await _servicio.ObtenerTodosProductos();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Codigo.HasValue)
        {
            var controlDetalle = await _servicio.ObtenerControl(Codigo.Value);
            Control = new()
            {
                CodCampaña = controlDetalle.CodCampaña,
                CodApiario = controlDetalle.CodApiario,
                CodAlimento = controlDetalle.CodAlimento ?? 0,
                CodEnfermedad = controlDetalle.CodEnfermedad ?? 0,
                CodProductos = controlDetalle.CodProductos ?? 0,
                CantDeColmenas = controlDetalle.CantDeColmenas,
                CantidadAlimento = controlDetalle.CantidadAlimento,
                CantProducto = controlDetalle.CantProducto,
                Fecha = controlDetalle.Fecha,
                Observaciones = controlDetalle.Observaciones
            };
        }
    }
}
