@page "/crear-enfermedad"
@page "/actualizar-enfermedad/{codigo:int}"
@inject IApiariosServicio _servicio
@inject NavigationManager _navegationmanager

<PageTitle>Enfermedad</PageTitle>

@if (Codigo is null)
{
    <h3>Crear Enfermedad</h3>
}
else
{
    <h3>Actualizar Enfermedad</h3>
}

<MensajeError Mensaje="@mensajeError" />

<EditForm Model="Enfermedad" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label for="nombre" class="form-label">Nombre</label>
        <InputText class="form-control" id="nombre" @bind-Value="Enfermedad.Nombre" />
        <ValidationMessage For="() => Enfermedad.Nombre" />
    </div>
    <a href="/enfermedades" class="btn btn-secondary">Volver</a>
    <button type="submit" class="btn btn-primary">Guardar</button>
</EditForm>

@code {
    [Parameter]
    public int? Codigo { get; set; }
    public EnfermedadDto Enfermedad { get; set; } = new EnfermedadDto();
    string? mensajeError;

    protected async Task HandleSubmit()
    {
        mensajeError = null;
        try
        {
            if (Codigo is null)
            {
                await _servicio.CrearEnfermedad(Enfermedad);
            }
            else
            {
                await _servicio.ModificarEnfermedad(Codigo.Value, Enfermedad);
            }
        }
        catch (HttpRequestException ex)
        {
            mensajeError = ex.Message;
            return;
        }

        _navegationmanager.NavigateTo("/enfermedades");
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Codigo.HasValue)
        {
            var enfermedadDetalle = await _servicio.ObtenerEnfermedad(Codigo.Value);
            Enfermedad = new()
            {
                Nombre = enfermedadDetalle.Nombre ?? string.Empty
            };
        }
    }
}
