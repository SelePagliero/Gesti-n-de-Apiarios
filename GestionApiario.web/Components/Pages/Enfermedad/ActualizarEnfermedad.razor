@page "/crear-enfermedad"
@page "/actualizar-enfermedad/{codigo:int}"
@using GestionApiario.compartido.Dto
@using GestionApiario.web.Servicios.Interfaces
@inject IApiariosServicio _servicio;
@inject NavigationManager _navegationmanager;

@rendermode InteractiveServer

@if (Codigo is null)
{
    <h3>Crear Enfermedad</h3>
}
else
{
    <h3>Actualizar Enfermedad</h3>
}

<EditForm FormName="ActualizarEnfermedad" Model="Enfermedad" OnSubmit="HandleSubmit">
    <label for="nombre">Nombre</label>
    <InputText class="form-control" id="nombre" @bind-Value=Enfermedad.Nombre></InputText>
    <button type="submit" class="btn btn-primary">Guardar</button>
</EditForm>


@code {
    [Parameter]
    public int? Codigo { get; set; }
    public EnfermedadDto Enfermedad { get; set; } = new EnfermedadDto();
    protected async Task HandleSubmit()
    {
        if (Codigo is null)
        {
            await _servicio.CrearEnfermedad(Enfermedad);
        }
        else
        {
            await _servicio.ModificarEnfermedad(Codigo.Value, Enfermedad);
        }

        _navegationmanager.NavigateTo("/enfermedades");

    }

    protected override async Task OnParametersSetAsync()
    {
        if (Codigo.HasValue)
        {
            var enfermedadDetalle = await _servicio.ObtenerEnfermedades(Codigo.Value);
            Enfermedad = new()
            {
                Nombre = enfermedadDetalle.Nombre
            };
        }


    }
}
