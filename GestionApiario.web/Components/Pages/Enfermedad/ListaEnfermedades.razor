@page "/enfermedades"
@using GestionApiario.compartido.Dto
@using GestionApiario.web.Servicios.Interfaces
@inject IApiariosServicio _servicio;
@inject NavigationManager _navigationManager;

@rendermode InteractiveServer

<PageTitle>Enfermedades</PageTitle>

<h1>Enfermedades</h1>

@if (enfermedades == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <a href="/crear-enfermedad" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Crear Enfermedad</a>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Fecha de alta</th>
                <th>Fecha de modificación</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var enfermedad in enfermedades)
            {
                <tr>
                    <td>@enfermedad.Codigo</td>
                    <td>@enfermedad.Nombre</td>
                    <td>@enfermedad.FechaAlta</td>
                    <td>
                        @if (enfermedad.FechaModificacion.HasValue)
                        {
                            @enfermedad.FechaModificacion
                        }
                        else
                        {
                            @enfermedad.FechaAlta
                        }
                    </td>
                    <td>
                        <a href="/actualizar-enfermedad/@enfermedad.Codigo" class="btn btn-dark"><i class="bi bi-pencil-square"></i>Editar</a>
                        <button onclick="@(() => EliminarEnfermedad(@enfermedad.Codigo))" class="btn btn-danger"><i class="bi bi-trash"></i>Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    List<EnfermedadGrillaDto>? enfermedades = null;

    protected override async Task OnInitializedAsync()
    {
        await CargarEnfermedad();
    }

    async Task EliminarEnfermedad(int codigo)
    {
        await _servicio.EliminarEnfermedad(codigo);
        _navigationManager.Refresh(true);
    }

    async Task CargarEnfermedad()
    {
        enfermedades = await _servicio.ObtenerTodasEnfermedades();
    }
}


