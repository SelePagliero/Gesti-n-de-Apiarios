@page "/enfermedades"
@inject IApiariosServicio _servicio
@inject NavigationManager _navegationmanager
@inject IJSRuntime JS

<PageTitle>Enfermedades</PageTitle>

<EncabezadoPagina Titulo="Enfermedades" Descripcion="Enfermedades que se pueden registrar en los controles.">
    @if (esAdministrador)
    {
        <a href="/crear-enfermedad" class="btn btn-nuevo"><i class="bi bi-plus-lg" aria-hidden="true"></i>Nueva enfermedad</a>
    }
</EncabezadoPagina>

<MensajeError Mensaje="@mensajeError" />

@* Los filtros se aplican en pantalla sobre la lista cargada y se guardan en la URL (?nombre=...&desde=...). *@
<TarjetaFiltros Resumen="@TarjetaFiltros.Mostrando(Filtrados?.Count, "enfermedad", "enfermedades")" HayFiltros="HayFiltros" AlLimpiar="LimpiarFiltros">
    <div>
        <label for="filtroNombre" class="form-label">Nombre</label>
        <input id="filtroNombre" type="search" class="form-control" placeholder="Buscar..." value="@nombre"
               @oninput="e => CambiarNombre(e.Value?.ToString())" />
    </div>
    <div>
        <label for="filtroDesde" class="form-label">Alta desde</label>
        <input id="filtroDesde" type="date" class="form-control" value="@FiltrosLista.FormatoUrl(desde)"
               @onchange='e => CambiarFecha(ref desde, "desde", e.Value?.ToString())' />
    </div>
    <div>
        <label for="filtroHasta" class="form-label">Alta hasta</label>
        <input id="filtroHasta" type="date" class="form-control" value="@FiltrosLista.FormatoUrl(hasta)"
               @onchange='e => CambiarFecha(ref hasta, "hasta", e.Value?.ToString())' />
    </div>
</TarjetaFiltros>

<MensajeError Mensaje="@(RangoInvalido ? FiltrosLista.MensajeRangoInvalido : null)" />

@if (enfermedades == null)
{
    <p><em>Cargando...</em></p>
}
else
{
    @if (Filtrados!.Count == 0)
    {
        <p class="text-muted">
            @(HayFiltros ? "No hay enfermedades que coincidan con los filtros." : "Todavía no hay enfermedades cargadas.")
        </p>
    }
    else
    {
        <div class="tabla-tarjeta">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th class="numero">Código</th>
                        <th>Nombre</th>
                        <th>Fecha de alta</th>
                        <th>Fecha de modificación</th>
                        @if (esAdministrador)
                        {
                            <th class="col-acciones"><span class="visually-hidden">Acciones</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var enfermedad in Filtrados)
                    {
                        <tr>
                            <td class="numero">@enfermedad.Codigo</td>
                            <td>@enfermedad.Nombre</td>
                            <td>@enfermedad.FechaAlta?.ToString("g")</td>
                            <td>@((enfermedad.FechaModificacion ?? enfermedad.FechaAlta)?.ToString("g"))</td>
                            @if (esAdministrador)
                            {
                                <td class="col-acciones">
                                    <AccionesFila Tipo="enfermedad"
                                                  Nombre="@enfermedad.Nombre"
                                                  UrlEditar="@($"/actualizar-enfermedad/{enfermedad.Codigo}")"
                                                  AlEliminar="() => EliminarEnfermedad(enfermedad)" />
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    List<EnfermedadGrillaDto>? enfermedades = null;
    string? mensajeError;
    bool esAdministrador;

    // Filtros (se leen de la URL al entrar).
    [SupplyParameterFromQuery(Name = "nombre")] public string? ParamNombre { get; set; }
    [SupplyParameterFromQuery(Name = "desde")] public string? ParamDesde { get; set; }
    [SupplyParameterFromQuery(Name = "hasta")] public string? ParamHasta { get; set; }
    string? nombre;
    DateOnly? desde;
    DateOnly? hasta;

    [CascadingParameter]
    Task<AuthenticationState>? Autenticacion { get; set; }

    bool HayFiltros => !string.IsNullOrWhiteSpace(nombre) || desde is not null || hasta is not null;
    bool RangoInvalido => desde is not null && hasta is not null && desde > hasta;

    List<EnfermedadGrillaDto>? Filtrados => enfermedades?
        .Where(x => !RangoInvalido)
        .Where(x => FiltrosLista.Contiene(x.Nombre, nombre))
        .Where(x => FiltrosLista.EntreFechas(x.FechaAlta, desde, hasta))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        nombre = ParamNombre;
        desde = FiltrosLista.LeerFecha(ParamDesde);
        hasta = FiltrosLista.LeerFecha(ParamHasta);
        esAdministrador = await Autenticacion.EsAdministradorAsync();
        await CargarEnfermedades();
    }

    void CambiarNombre(string? valor)
    {
        nombre = valor;
        _navegationmanager.CambiarParametro("nombre", valor);
    }

    void CambiarFecha(ref DateOnly? campo, string parametro, string? valor)
    {
        campo = FiltrosLista.LeerFecha(valor);
        _navegationmanager.CambiarParametro(parametro, FiltrosLista.FormatoUrl(campo));
    }

    void LimpiarFiltros()
    {
        nombre = null;
        desde = hasta = null;
        _navegationmanager.NavigateTo("/enfermedades", replace: true);
    }

    async Task EliminarEnfermedad(EnfermedadGrillaDto enfermedad)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar la enfermedad \"{enfermedad.Nombre}\"?"))
            return;

        mensajeError = null;
        try
        {
            await _servicio.EliminarEnfermedad(enfermedad.Codigo);
            await CargarEnfermedades();
        }
        catch (HttpRequestException ex)
        {
            mensajeError = ex.Message;
        }
    }

    async Task CargarEnfermedades()
    {
        enfermedades = await _servicio.ObtenerTodasEnfermedades();
    }
}
