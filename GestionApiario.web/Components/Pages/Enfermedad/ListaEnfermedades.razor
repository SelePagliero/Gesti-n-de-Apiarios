@page "/enfermedades"
@inject IApiariosServicio _servicio
@inject IJSRuntime JS

<PageTitle>Enfermedades</PageTitle>

<EncabezadoPagina Titulo="Enfermedades" Descripcion="Enfermedades que se pueden registrar en los controles.">
    @if (esAdministrador)
    {
        <a href="/crear-enfermedad" class="btn btn-nuevo"><i class="bi bi-plus-lg" aria-hidden="true"></i>Nueva enfermedad</a>
    }
</EncabezadoPagina>

<MensajeError Mensaje="@mensajeError" />

@if (enfermedades == null)
{
    <p><em>Cargando...</em></p>
}
else
{
    @if (enfermedades.Count == 0)
    {
        <p class="text-muted">Todavía no hay enfermedades cargadas.</p>
    }
    else
    {
        <div class="tabla-tarjeta">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th class="numero">Código</th>
                        <th>Nombre</th>
                        <th>Fecha de alta</th>
                        <th>Fecha de modificación</th>
                        @if (esAdministrador)
                        {
                            <th class="col-acciones"><span class="visually-hidden">Acciones</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var enfermedad in enfermedades)
                    {
                        <tr>
                            <td class="numero">@enfermedad.Codigo</td>
                            <td>@enfermedad.Nombre</td>
                            <td>@enfermedad.FechaAlta?.ToString("g")</td>
                            <td>@((enfermedad.FechaModificacion ?? enfermedad.FechaAlta)?.ToString("g"))</td>
                            @if (esAdministrador)
                            {
                                <td class="col-acciones">
                                    <AccionesFila Tipo="enfermedad"
                                                  Nombre="@enfermedad.Nombre"
                                                  UrlEditar="@($"/actualizar-enfermedad/{enfermedad.Codigo}")"
                                                  AlEliminar="() => EliminarEnfermedad(enfermedad)" />
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    List<EnfermedadGrillaDto>? enfermedades = null;
    string? mensajeError;
    bool esAdministrador;

    [CascadingParameter]
    Task<AuthenticationState>? Autenticacion { get; set; }

    protected override async Task OnInitializedAsync()
    {
        esAdministrador = await Autenticacion.EsAdministradorAsync();
        await CargarEnfermedades();
    }

    async Task EliminarEnfermedad(EnfermedadGrillaDto enfermedad)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar la enfermedad \"{enfermedad.Nombre}\"?"))
            return;

        mensajeError = null;
        try
        {
            await _servicio.EliminarEnfermedad(enfermedad.Codigo);
            await CargarEnfermedades();
        }
        catch (HttpRequestException ex)
        {
            mensajeError = ex.Message;
        }
    }

    async Task CargarEnfermedades()
    {
        enfermedades = await _servicio.ObtenerTodasEnfermedades();
    }
}
