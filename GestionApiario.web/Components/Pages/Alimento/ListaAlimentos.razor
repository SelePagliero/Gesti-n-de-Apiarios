@page "/alimentos"
@inject IApiariosServicio _servicio
@inject IJSRuntime JS

<PageTitle>Alimentos</PageTitle>

<EncabezadoPagina Titulo="Alimentos" Descripcion="Alimentos que se pueden registrar en los controles.">
    @if (esAdministrador)
    {
        <a href="/crear-alimento" class="btn btn-nuevo"><i class="bi bi-plus-lg" aria-hidden="true"></i>Nuevo alimento</a>
    }
</EncabezadoPagina>

<MensajeError Mensaje="@mensajeError" />

@if (alimentos == null)
{
    <p><em>Cargando...</em></p>
}
else
{
    @if (alimentos.Count == 0)
    {
        <p class="text-muted">Todavía no hay alimentos cargados.</p>
    }
    else
    {
        <div class="tabla-tarjeta">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th class="numero">Código</th>
                        <th>Nombre</th>
                        <th>Fecha de alta</th>
                        <th>Fecha de modificación</th>
                        @if (esAdministrador)
                        {
                            <th class="col-acciones"><span class="visually-hidden">Acciones</span></th>
                        }
                    </tr>
                </thead>
                <tbody>
                    @foreach (var alimento in alimentos)
                    {
                        <tr>
                            <td class="numero">@alimento.Codigo</td>
                            <td>@alimento.Nombre</td>
                            <td>@alimento.FechaAlta?.ToString("g")</td>
                            <td>@((alimento.FechaModificacion ?? alimento.FechaAlta)?.ToString("g"))</td>
                            @if (esAdministrador)
                            {
                                <td class="col-acciones">
                                    <AccionesFila Tipo="alimento"
                                                  Nombre="@alimento.Nombre"
                                                  UrlEditar="@($"/actualizar-alimento/{alimento.Codigo}")"
                                                  AlEliminar="() => EliminarAlimento(alimento)" />
                                </td>
                            }
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    List<AlimentoGrillaDto>? alimentos = null;
    string? mensajeError;
    bool esAdministrador;

    [CascadingParameter]
    Task<AuthenticationState>? Autenticacion { get; set; }

    protected override async Task OnInitializedAsync()
    {
        esAdministrador = await Autenticacion.EsAdministradorAsync();
        await CargarAlimentos();
    }

    async Task EliminarAlimento(AlimentoGrillaDto alimento)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar el alimento \"{alimento.Nombre}\"?"))
            return;

        mensajeError = null;
        try
        {
            await _servicio.EliminarAlimento(alimento.Codigo);
            await CargarAlimentos();
        }
        catch (HttpRequestException ex)
        {
            mensajeError = ex.Message;
        }
    }

    async Task CargarAlimentos()
    {
        alimentos = await _servicio.ObtenerTodosAlimentos();
    }
}
