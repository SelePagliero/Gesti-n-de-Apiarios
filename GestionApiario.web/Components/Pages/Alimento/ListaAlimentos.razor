@page "/alimentos"
@using GestionApiario.compartido.Dto
@using GestionApiario.web.Servicios.Interfaces
@inject IApiariosServicio _servicio;
@inject NavigationManager _navigationManager;

@rendermode InteractiveServer

<PageTitle>Alimentos</PageTitle>

<h1>Alimentos</h1>

@if (alimentos == null)
{
    <p><em>Loading...</em></p>
}
else
{
    <a href="/crear-alimento" class="btn btn-primary"><i class="bi bi-plus-circle"></i> Crear Alimento</a>
    <table class="table table-striped">
        <thead>
            <tr>
                <th>Código</th>
                <th>Nombre</th>
                <th>Fecha de alta</th>
                <th>Fecha de modificación</th>
                <th>Acciones</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var alimento in alimentos)
            {
                <tr>
                    <td>@alimento.Codigo</td>
                    <td>@alimento.Nombre</td>
                    <td>@alimento.FechaAlta</td>
                    <td>
                        @if (alimento.FechaModificacion.HasValue)
                        {
                            @alimento.FechaModificacion
                        }
                        else
                        {
                            @alimento.FechaAlta
                        }
                    </td>
                    <td>
                        <a href="/actualizar-alimento/@alimento.Codigo" class="btn btn-dark"><i class="bi bi-pencil-square"></i>Editar</a>
                        <button onclick="@(() => EliminarAlimento(@alimento.Codigo))" class="btn btn-danger"><i class="bi bi-trash"></i>Eliminar</button>
                    </td>
                </tr>
            }
        </tbody>
    </table>
}

@code {
    List<AlimentoGrillaDto>? alimentos = null;

    protected override async Task OnInitializedAsync()
    {
        await CargarAlimentos();
    }

    async Task EliminarAlimento(int codigo)
    {
        await _servicio.EliminarAlimento(codigo);
        _navigationManager.Refresh(forceReload: true);
    }

    async Task CargarAlimentos()
    {
        alimentos = await _servicio.ObtenerTodosAlimentos();
    }
}
