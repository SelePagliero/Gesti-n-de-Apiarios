@page "/crear-alimento"
@page "/actualizar-alimento/{codigo:int}"
@inject IApiariosServicio _servicio
@inject NavigationManager _navegationmanager

<PageTitle>Alimento</PageTitle>

<EncabezadoPagina Titulo="@(Codigo is null ? "Nuevo alimento" : "Editar alimento")" />

@* Los catálogos solo los modifica la Administradora; la API también lo exige. *@
<AuthorizeView Roles="@RolesUsuario.Administrador" Context="autorizacion">
    <Authorized>
        <MensajeError Mensaje="@mensajeError" />

        <EditForm Model="Alimento" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />
            <div class="mb-3">
                <label for="nombre" class="form-label">Nombre</label>
                <InputText class="form-control" id="nombre" @bind-Value="Alimento.Nombre" />
                <ValidationMessage For="() => Alimento.Nombre" />
            </div>
            <div class="acciones-formulario">
                <button type="submit" class="btn btn-guardar">Guardar</button>
                <a href="/alimentos" class="btn btn-cancelar">Cancelar</a>
            </div>
        </EditForm>
    </Authorized>
    <NotAuthorized>
        <MensajeError Mensaje="No tenés permiso para realizar esta acción." />
        <a href="/alimentos" class="btn btn-secondary">Volver</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public int? Codigo { get; set; }
    public AlimentoDto Alimento { get; set; } = new AlimentoDto();
    string? mensajeError;

    protected async Task HandleSubmit()
    {
        mensajeError = null;
        try
        {
            if (Codigo is null)
            {
                await _servicio.CrearAlimento(Alimento);
            }
            else
            {
                await _servicio.ModificarAlimento(Codigo.Value, Alimento);
            }
        }
        catch (HttpRequestException ex)
        {
            mensajeError = ex.Message;
            return;
        }

        _navegationmanager.NavigateTo("/alimentos");
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Codigo.HasValue)
        {
            var alimentoDetalle = await _servicio.ObtenerAlimento(Codigo.Value);
            Alimento = new()
            {
                Nombre = alimentoDetalle.Nombre ?? string.Empty
            };
        }
    }
}
