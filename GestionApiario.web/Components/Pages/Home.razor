@page "/"
@inject IApiariosServicio _servicio
@inject IJSRuntime JSRuntime

<PageTitle>Inicio</PageTitle>

<EncabezadoPagina Titulo="Inicio" Descripcion="@(esAdministrador ? "Resumen de los apiarios de todos los apicultores." : "Resumen de tus apiarios según el último control de cada uno.")">
    @if (esAdministrador)
    {
        <div class="selector-apicultor">
            <label for="tableroApicultor" class="form-label">Mostrar datos de</label>
            <select id="tableroApicultor" class="form-select" value="@(usuarioSeleccionado ?? "")" @onchange="CambiarApicultor">
                <option value="">Todos los apicultores</option>
                @foreach (var usuario in usuarios)
                {
                    <option value="@usuario.Id">@usuario.Email</option>
                }
            </select>
        </div>
    }
</EncabezadoPagina>

<div class="row g-3 mb-4">
    <div class="col-12 col-md-4">
        <div class="card indicador indicador-ambar h-100">
            <div class="card-body">
                <div class="indicador-icono"><i class="bi bi-hexagon" aria-hidden="true"></i></div>
                <div>
                    <div class="indicador-titulo">Apiarios activos</div>
                    <div id="tablero-apiarios" class="indicador-valor">@DashBoard.ApiariosActivos</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card indicador indicador-verde h-100">
            <div class="card-body">
                <div class="indicador-icono"><i class="bi bi-grid-3x3-gap" aria-hidden="true"></i></div>
                <div>
                    <div class="indicador-titulo">Colmenas en total</div>
                    <div id="tablero-colmenas" class="indicador-valor">@DashBoard.CantidadTotalDeColmenas</div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 col-md-4">
        <div class="card indicador indicador-rojo h-100">
            <div class="card-body">
                <div class="indicador-icono"><i class="bi bi-heart-pulse" aria-hidden="true"></i></div>
                <div>
                    <div class="indicador-titulo">Apiarios con enfermedades</div>
                    <div id="tablero-enfermos" class="indicador-valor">@DashBoard.ApiariosConEnfermedades</div>
                </div>
            </div>
        </div>
    </div>
</div>

@if (datosGrafico is null)
{
    <p class="text-muted"><em>Cargando...</em></p>
}
else if (HayEnfermedades)
{
    <div class="card">
        <div class="card-header py-3">
            <h2 class="titulo-tarjeta">Enfermedades encontradas</h2>
            <small class="text-muted">Porcentaje de apiarios según la enfermedad de su último control</small>
        </div>
        <div class="card-body">
            <div class="grafico-contenedor">
                <canvas id="enfermedadesGrafico"></canvas>
            </div>
        </div>
    </div>
}
else
{
    <div class="card estado-sano">
        <div class="card-body text-center py-5">
            <div class="estado-sano-icono"><i class="bi bi-check-circle" aria-hidden="true"></i></div>
            <h4 class="mb-2">¡Excelente!</h4>
            <p class="mb-0">No se han registrado enfermedades en los apiarios</p>
            <p class="text-muted small mb-0">Todos los apiarios se encuentran en estado óptimo</p>
        </div>
    </div>
}

@code {
    public DashBoardDto DashBoard { get; set; } = new DashBoardDto();
    private EnfermedadesGraficoResponse? datosGrafico;
    private bool graficoDibujado;

    private bool HayEnfermedades => datosGrafico?.datasets.Any(d => d.data.Count > 0) == true;

    private bool esAdministrador;
    private List<UsuarioDto> usuarios = new();
    private string? usuarioSeleccionado;

    [CascadingParameter]
    Task<AuthenticationState>? Autenticacion { get; set; }

    protected override async Task OnInitializedAsync()
    {
        esAdministrador = await Autenticacion.EsAdministradorAsync();
        if (esAdministrador)
            usuarios = await _servicio.ObtenerUsuarios();

        await CargarTablero();
    }

    // Un apicultor ve solo sus datos; la Administradora ve todos o los de un apicultor (lo resuelve la API).
    private async Task CargarTablero()
    {
        DashBoard = await _servicio.ObtenerDashBoard(usuarioSeleccionado);
        datosGrafico = await _servicio.ObtenerDatosGraficoEnfermedades(usuarioSeleccionado);
        graficoDibujado = false;
    }

    private async Task CambiarApicultor(ChangeEventArgs e)
    {
        var valor = e.Value?.ToString();
        usuarioSeleccionado = string.IsNullOrEmpty(valor) ? null : valor;
        await CargarTablero();
    }

    // El gráfico se dibuja después de que el <canvas> ya está en la página.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (HayEnfermedades && !graficoDibujado)
        {
            graficoDibujado = true;
            await JSRuntime.InvokeVoidAsync("renderGraficoEnfermedades", datosGrafico);
        }
    }
}
