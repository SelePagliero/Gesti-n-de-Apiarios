@page "/"
@inject IApiariosServicio _servicio
@inject IJSRuntime JSRuntime

<PageTitle>Principal</PageTitle>

<div class="row">
    <div class="col-xl-4 col-md-6 mb-4">
        <div class="card border-left-primary shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                            Apiarios Activos
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@DashBoard.ApiariosActivos</div>
                    </div>
                    <div class="col-auto">
                        <i class="bi bi-geo-alt-fill text-gray-300" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-md-6 mb-4">
        <div class="card border-left-success shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                            Cantidad Total de Colmenas
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@DashBoard.CantidadTotalDeColmenas</div>
                    </div>
                    <div class="col-auto">
                        <i class="bi bi-hexagon-fill text-gray-300" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-xl-4 col-md-6 mb-4">
        <div class="card border-left-danger shadow h-100 py-2">
            <div class="card-body">
                <div class="row no-gutters align-items-center">
                    <div class="col mr-2">
                        <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                            Apiarios con Enfermedades
                        </div>
                        <div class="h5 mb-0 font-weight-bold text-gray-800">@DashBoard.ApiariosConEnfermedades</div>
                    </div>
                    <div class="col-auto">
                        <i class="bi bi-virus text-gray-300" style="font-size: 2rem;"></i>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row">
    @if (datosGrafico is null)
    {
        <div class="col-12"><p><em>Cargando...</em></p></div>
    }
    else if (HayEnfermedades)
    {
        <div class="col-xl-12 col-lg-12">
            <div class="card shadow mb-4">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Porcentaje de enfermedades encontradas</h6>
                </div>
                <div class="card-body">
                    <div class="chart-pie pt-4">
                        <canvas id="enfermedadesGrafico"></canvas>
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="col-xl-12 col-lg-12">
            <div class="card shadow mb-4 border-left-success">
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-success">Estado Sanitario</h6>
                </div>
                <div class="card-body text-center py-5">
                    <div class="mb-3">
                        <i class="bi bi-check-circle-fill text-success" style="font-size: 4rem;"></i>
                    </div>
                    <h4 class="font-weight-bold text-success mb-2">¡Excelente!</h4>
                    <p class="text-gray-600 mb-0">No se han registrado enfermedades en los apiarios</p>
                    <p class="text-gray-500 small">Todos los apiarios se encuentran en estado óptimo</p>
                </div>
            </div>
        </div>
    }
</div>

@code {
    public DashBoardDto DashBoard { get; set; } = new DashBoardDto();
    private EnfermedadesGraficoResponse? datosGrafico;
    private bool graficoDibujado;

    private bool HayEnfermedades => datosGrafico?.datasets.Any(d => d.data.Count > 0) == true;

    protected override async Task OnInitializedAsync()
    {
        DashBoard = await _servicio.ObtenerDashBoard();
        datosGrafico = await _servicio.ObtenerDatosGraficoEnfermedades();
    }

    // El gráfico se dibuja después de que el <canvas> ya está en la página.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (HayEnfermedades && !graficoDibujado)
        {
            graficoDibujado = true;
            await JSRuntime.InvokeVoidAsync("renderGraficoEnfermedades", datosGrafico);
        }
    }
}
