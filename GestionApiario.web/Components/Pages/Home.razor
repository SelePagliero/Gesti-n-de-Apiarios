@page "/"
@using GestionApiario.compartido.Dto
@using GestionApiario.web.Servicios.Interfaces
@inject IApiariosServicio _servicio;
@inject NavigationManager _navegationmanager;

@rendermode InteractiveServer

<PageTitle>Principal</PageTitle>

<body class="body-home">
    <div class="row">

        <!-- Earnings (Monthly) Card Example -->
        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-primary text-uppercase mb-1">
                                Apiarios Activos
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@DashBoard.ApiariosActivos</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-calendar fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Earnings (Monthly) Card Example -->
        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-success text-uppercase mb-1">
                                Cantidad Total de Colmenas
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@DashBoard.CantidadTotalDeColmenas</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-dollar-sign fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Pending Requests Card Example -->
        <div class="col-xl-4 col-md-6 mb-4">
            <div class="card border-left-danger shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="text-xs font-weight-bold text-danger text-uppercase mb-1">
                                Apiarios con Enfermedades
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800">@DashBoard.ApiariosConEnfermedades</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-comments fa-2x text-gray-300"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row">
        @if (mostrarGrafico)
        {
            <div class="col-xl-12 col-lg-12">
                <div class="card shadow mb-4">
                <!-- Card Header - Dropdown -->
                <div class="card-header py-3">
                    <h6 class="m-0 font-weight-bold text-primary">Porcentaje de enfermedades encontradas</h6>
                </div>
                <!-- Card Body -->
                <div class="card-body">
                    <div class="chart-pie pt-4">
                        <canvas id="enfermedadesGrafico"></canvas>
                    </div>                    
                </div>
            </div>
            </div>
        }
        else
        {
            <div class="col-xl-12 col-lg-12">
                <div class="card shadow mb-4 border-left-success">
                    <!-- Card Header -->
                    <div class="card-header py-3">
                        <h6 class="m-0 font-weight-bold text-success">Estado Sanitario</h6>
                    </div>
                    <!-- Card Body -->
                    <div class="card-body text-center py-5">
                        <div class="mb-3">
                            <i class="fas fa-check-circle fa-4x text-success"></i>
                        </div>
                        <h4 class="font-weight-bold text-success mb-2">¡Excelente!</h4>
                        <p class="text-gray-600 mb-0">No se han registrado enfermedades en los apiarios</p>
                        <p class="text-gray-500 small">Todos los apiarios se encuentran en estado óptimo</p>
                    </div>
                </div>
            </div>
        }
    </div>
   
</body>

@code{
    [Inject] IJSRuntime JSRuntime { get; set; }
    public DashBoardDto DashBoard { get; set; } = new DashBoardDto();
    public bool mostrarGrafico = false;
    
    protected override async Task OnInitializedAsync()
    {
        var response = await _servicio.ObtenerDashBoard();
        DashBoard.ApiariosActivos = response.ApiariosActivos;
        DashBoard.ApiariosConEnfermedades = response.ApiariosConEnfermedades;
        DashBoard.CantidadTotalDeColmenas = response.CantidadTotalDeColmenas;
        
        // No renderizar el gráfico aquí, esperar a OnAfterRenderAsync
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await RenderChartEnfermedadesAsync();
        }
    }

    private async Task RenderChartEnfermedadesAsync()
    {
        var enfermedadesData = await _servicio.ObtenerDatosGraficoEnfermedades();
        
        // Verificar si hay datos
        bool hayDatos = enfermedadesData?.datasets != null && 
                        enfermedadesData.datasets.Any(d => d.data != null && d.data.Count > 0);
        
        if (hayDatos)
        {
            mostrarGrafico = true;
            StateHasChanged(); // Forzar actualización del UI para renderizar el canvas
            
            // Esperar un tick para que el DOM se actualice
            await Task.Delay(10);
            
            // Ahora sí invocar el JavaScript con el canvas ya en el DOM
            await JSRuntime.InvokeVoidAsync("renderGraficoEnfermedades", enfermedadesData);
        }
        else
        {
            mostrarGrafico = false;
            StateHasChanged();
        }
    }
}