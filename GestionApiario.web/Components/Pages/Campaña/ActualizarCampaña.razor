@page "/crear-campaña"
@page "/actualizar-campaña/{codigo:int}"
@inject IApiariosServicio _servicio
@inject NavigationManager _navegationmanager

<PageTitle>Campaña</PageTitle>

<EncabezadoPagina Titulo="@(Codigo is null ? "Nueva campaña" : "Editar campaña")" />

<MensajeError Mensaje="@mensajeError" />

<EditForm Model="Campaña" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    @if (esAdministrador)
    {
        @* Solo la Administradora elige el dueño. La API también lo exige. *@
        <div class="mb-3">
            <label for="dueño" class="form-label">Dueño (apicultor)</label>
            <InputSelect id="dueño" class="form-select" @bind-Value="Campaña.UsuarioId">
                @foreach (var usuario in usuarios)
                {
                    <option value="@usuario.Id">@usuario.Email</option>
                }
            </InputSelect>
            @if (Codigo is not null && Campaña.UsuarioId != dueñoOriginal)
            {
                <small class="form-text text-warning">Al guardar, la campaña pasa al nuevo dueño. No se puede si la usan controles de apiarios de otro apicultor.</small>
            }
        </div>
    }
    <div class="mb-3">
        <label for="año" class="form-label">Año</label>
        <InputNumber class="form-control" id="año" @bind-Value="Campaña.Año" />
        <ValidationMessage For="() => Campaña.Año" />
    </div>
    <div class="mb-3">
        <label for="responsable" class="form-label">Responsable</label>
        <InputText class="form-control" id="responsable" @bind-Value="Campaña.Responsable" />
        <ValidationMessage For="() => Campaña.Responsable" />
    </div>
    <div class="acciones-formulario">
        <button type="submit" class="btn btn-guardar">Guardar</button>
        <a href="/campanias" class="btn btn-cancelar">Cancelar</a>
    </div>
</EditForm>

@code {
    [Parameter]
    public int? Codigo { get; set; }
    public CampañaDto Campaña { get; set; } = new CampañaDto { Año = DateTime.Today.Year };
    string? mensajeError;
    bool esAdministrador;
    List<UsuarioDto> usuarios = new();
    string? dueñoOriginal;

    [CascadingParameter]
    Task<AuthenticationState>? Autenticacion { get; set; }

    protected override async Task OnInitializedAsync()
    {
        esAdministrador = await Autenticacion.EsAdministradorAsync();
        if (esAdministrador)
            usuarios = await _servicio.ObtenerUsuarios();
    }

    protected async Task HandleSubmit()
    {
        mensajeError = null;
        try
        {
            if (Codigo is null)
            {
                await _servicio.CrearCampaña(Campaña);
            }
            else
            {
                await _servicio.ModificarCampaña(Codigo.Value, Campaña);
            }
        }
        catch (HttpRequestException ex)
        {
            mensajeError = ex.Message;
            return;
        }

        _navegationmanager.NavigateTo("/campanias");
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Codigo.HasValue)
        {
            var campañaDetalle = await _servicio.ObtenerCampaña(Codigo.Value);
            Campaña = new()
            {
                Año = campañaDetalle.Año,
                Responsable = campañaDetalle.Responsable,
                UsuarioId = campañaDetalle.UsuarioId
            };
            dueñoOriginal = campañaDetalle.UsuarioId;
        }
        else if (esAdministrador && string.IsNullOrEmpty(Campaña.UsuarioId))
        {
            // Al crear, la Administradora queda como dueña salvo que elija otro apicultor.
            var email = (await Autenticacion!).User.Identity?.Name;
            Campaña.UsuarioId = usuarios.FirstOrDefault(u => u.Email == email)?.Id;
        }
    }
}
