@page "/crear-campaña"
@page "/actualizar-campaña/{codigo:int}"
@inject IApiariosServicio _servicio
@inject NavigationManager _navegationmanager

<PageTitle>Campaña</PageTitle>

@if (Codigo is null)
{
    <h3>Crear Campaña</h3>
}
else
{
    <h3>Actualizar Campaña</h3>
}

<MensajeError Mensaje="@mensajeError" />

<EditForm Model="Campaña" OnValidSubmit="HandleSubmit">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label for="año" class="form-label">Año</label>
        <InputNumber class="form-control" id="año" @bind-Value="Campaña.Año" />
        <ValidationMessage For="() => Campaña.Año" />
    </div>
    <div class="mb-3">
        <label for="responsable" class="form-label">Responsable</label>
        <InputText class="form-control" id="responsable" @bind-Value="Campaña.Responsable" />
        <ValidationMessage For="() => Campaña.Responsable" />
    </div>
    <a href="/campanias" class="btn btn-secondary">Volver</a>
    <button type="submit" class="btn btn-primary">Guardar</button>
</EditForm>

@code {
    [Parameter]
    public int? Codigo { get; set; }
    public CampañaDto Campaña { get; set; } = new CampañaDto { Año = DateTime.Today.Year };
    string? mensajeError;

    protected async Task HandleSubmit()
    {
        mensajeError = null;
        try
        {
            if (Codigo is null)
            {
                await _servicio.CrearCampaña(Campaña);
            }
            else
            {
                await _servicio.ModificarCampaña(Codigo.Value, Campaña);
            }
        }
        catch (HttpRequestException ex)
        {
            mensajeError = ex.Message;
            return;
        }

        _navegationmanager.NavigateTo("/campanias");
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Codigo.HasValue)
        {
            var campañaDetalle = await _servicio.ObtenerCampaña(Codigo.Value);
            Campaña = new()
            {
                Año = campañaDetalle.Año,
                Responsable = campañaDetalle.Responsable
            };
        }
    }
}
