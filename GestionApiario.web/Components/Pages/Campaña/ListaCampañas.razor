@page "/campanias"
@inject IApiariosServicio _servicio
@inject IJSRuntime JS

<PageTitle>Campañas</PageTitle>

<EncabezadoPagina Titulo="Campañas" Descripcion="Temporadas de trabajo para organizar los controles.">
    <a href="/crear-campaña" class="btn btn-nuevo"><i class="bi bi-plus-lg" aria-hidden="true"></i>Nueva campaña</a>
</EncabezadoPagina>

<MensajeError Mensaje="@mensajeError" />

@if (campañas == null)
{
    <p><em>Cargando...</em></p>
}
else
{
    @if (campañas.Count == 0)
    {
        <p class="text-muted">Todavía no hay campañas cargadas.</p>
    }
    else
    {
        <div class="tabla-tarjeta">
            <table class="table table-hover align-middle">
                <thead>
                    <tr>
                        <th class="numero">Código</th>
                        <th class="numero">Año</th>
                        <th>Responsable</th>
                        @if (esAdministrador)
                        {
                            <th>Apicultor</th>
                        }
                        <th>Fecha de alta</th>
                        <th>Fecha de modificación</th>
                        <th class="col-acciones"><span class="visually-hidden">Acciones</span></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var campaña in campañas)
                    {
                        <tr>
                            <td class="numero">@campaña.Codigo</td>
                            <td class="numero">@campaña.Año</td>
                            <td>@campaña.Responsable</td>
                            @if (esAdministrador)
                            {
                                <td>@campaña.Apicultor</td>
                            }
                            <td>@campaña.FechaAlta?.ToString("g")</td>
                            <td>@((campaña.FechaModificacion ?? campaña.FechaAlta)?.ToString("g"))</td>
                            <td class="col-acciones">
                                <AccionesFila Tipo="campaña"
                                              Nombre="@campaña.Responsable"
                                              UrlEditar="@($"/actualizar-campaña/{campaña.Codigo}")"
                                              AlEliminar="() => EliminarCampaña(campaña)" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
}

@code {
    List<CampañaGrillaDto>? campañas = null;
    string? mensajeError;
    bool esAdministrador;

    [CascadingParameter]
    Task<AuthenticationState>? Autenticacion { get; set; }

    // Cada apicultor ve solo sus campañas (lo resuelve la API); la Administradora ve todas con su dueño.
    protected override async Task OnInitializedAsync()
    {
        esAdministrador = await Autenticacion.EsAdministradorAsync();
        await CargarCampañas();
    }

    async Task EliminarCampaña(CampañaGrillaDto campaña)
    {
        if (!await JS.InvokeAsync<bool>("confirm", $"¿Eliminar la campaña {campaña.Año}?"))
            return;

        mensajeError = null;
        try
        {
            await _servicio.EliminarCampaña(campaña.Codigo);
            await CargarCampañas();
        }
        catch (HttpRequestException ex)
        {
            mensajeError = ex.Message;
        }
    }

    async Task CargarCampañas()
    {
        campañas = await _servicio.ObtenerTodasCampañas();
    }
}
