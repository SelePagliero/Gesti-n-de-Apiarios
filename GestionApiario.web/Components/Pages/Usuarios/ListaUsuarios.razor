@page "/usuarios"
@inject IApiariosServicio _servicio

<PageTitle>Usuarios</PageTitle>

<EncabezadoPagina Titulo="Usuarios" Descripcion="Las personas registradas en el sistema. Si un apicultor olvidó su contraseña, cambiásela desde acá." />

@* Solo la Administradora; la API también lo exige (responde 403 a los apicultores). *@
<AuthorizeView Roles="@RolesUsuario.Administrador" Context="autorizacion">
    <Authorized>
        @if (!string.IsNullOrEmpty(Cambiada))
        {
            <div class="alert alert-success" role="status">
                <i class="bi bi-check-circle-fill" aria-hidden="true"></i> Se cambió la contraseña de <strong>@Cambiada</strong>. Pasásela por un medio seguro; la anterior ya no sirve.
            </div>
        }

        @if (usuarios == null)
        {
            <p><em>Cargando...</em></p>
        }
        else
        {
            <div class="tabla-tarjeta">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Email</th>
                            <th>Rol</th>
                            <th class="numero">Apiarios</th>
                            <th class="col-acciones"><span class="visually-hidden">Acciones</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var usuario in usuarios)
                        {
                            <tr>
                                <td>
                                    @usuario.Email
                                    @if (usuario.Email == emailActual)
                                    {
                                        <span class="texto-suave ms-1">(vos)</span>
                                    }
                                </td>
                                <td>
                                    @if (usuario.EsAdministrador)
                                    {
                                        <span class="etiqueta etiqueta-miel">Administradora</span>
                                    }
                                    else
                                    {
                                        <span class="etiqueta etiqueta-neutra">Apicultor</span>
                                    }
                                </td>
                                <td class="numero">@usuario.CantidadApiarios</td>
                                <td class="col-acciones">
                                    @if (!usuario.EsAdministrador)
                                    {
                                        <a href="@($"/usuarios/{usuario.Id}/contrasena")" class="btn-texto"
                                           aria-label="Cambiar la contraseña de @usuario.Email">
                                            <i class="bi bi-key" aria-hidden="true"></i> Cambiar contraseña
                                        </a>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <MensajeError Mensaje="No tenés permiso para ver esta pantalla." />
        <a href="/" class="btn btn-cancelar">Volver</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    List<UsuarioGrillaDto>? usuarios = null;
    string? emailActual;

    // Email del apicultor al que se le acaba de cambiar la contraseña (lo pone ContraseñaUsuario al volver).
    [SupplyParameterFromQuery]
    public string? Cambiada { get; set; }

    [CascadingParameter]
    Task<AuthenticationState>? Autenticacion { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (!await Autenticacion.EsAdministradorAsync())
            return;

        emailActual = (await Autenticacion!).User.Identity?.Name;
        usuarios = await _servicio.ObtenerGrillaUsuarios();
    }
}
