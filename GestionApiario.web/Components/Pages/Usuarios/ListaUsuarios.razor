@page "/usuarios"
@inject IApiariosServicio _servicio
@inject NavigationManager _navegationmanager
@inject IJSRuntime JS

<PageTitle>Usuarios</PageTitle>

<EncabezadoPagina Titulo="Usuarios" Descripcion="Las personas registradas en el sistema. Si un apicultor olvidó su contraseña, restablecela desde acá." />

@* Solo la Administradora; la API también lo exige (responde 403 a los apicultores). *@
<AuthorizeView Roles="@RolesUsuario.Administrador" Context="autorizacion">
    <Authorized>
        <MensajeError Mensaje="@mensajeError" />

        @if (temporal is not null)
        {
            <div class="card tarjeta-contrasena mb-4" role="status">
                <div class="card-body">
                    <div class="tarjeta-contrasena-titulo">
                        <i class="bi bi-key" aria-hidden="true"></i> Contraseña temporal de @temporal.Email
                    </div>
                    <div class="contrasena-temporal">
                        <code id="contrasena-temporal">@temporal.Contraseña</code>
                        <button type="button" class="btn btn-cancelar" @onclick="Copiar">
                            <i class="bi @(copiada ? "bi-check2" : "bi-clipboard")" aria-hidden="true"></i> @(copiada ? "Copiada" : "Copiar")
                        </button>
                    </div>
                    <p class="mb-0">
                        Pasásela al apicultor. Cuando ingrese con ella, el sistema le va a pedir que elija una contraseña propia.
                        <strong>No se vuelve a mostrar:</strong> si la perdés, restablecela de nuevo.
                    </p>
                    <div class="acciones-formulario">
                        <button type="button" class="btn btn-guardar" @onclick="Ocultar">Listo</button>
                    </div>
                </div>
            </div>
        }

        @* Los filtros se aplican en pantalla sobre la lista cargada y se guardan en la URL (?email=...&rol=...). *@
        <TarjetaFiltros Resumen="@TarjetaFiltros.Mostrando(Filtrados?.Count, "usuario", "usuarios")" HayFiltros="HayFiltros" AlLimpiar="LimpiarFiltros">
            <div>
                <label for="filtroEmail" class="form-label">Email</label>
                <input id="filtroEmail" type="search" class="form-control" placeholder="Buscar..." value="@email"
                       @oninput='e => CambiarFiltro(ref email, "email", e.Value?.ToString())' />
            </div>
            <div>
                <label for="filtroRol" class="form-label">Rol</label>
                <select id="filtroRol" class="form-select" value="@(rol ?? "")"
                        @onchange='e => CambiarFiltro(ref rol, "rol", e.Value?.ToString())'>
                    <option value="">Todos</option>
                    <option value="@RolAdministradora">Administradora</option>
                    <option value="@RolApicultor">Apicultor</option>
                </select>
            </div>
            <div>
                <label for="filtroContrasena" class="form-label">Contraseña</label>
                <select id="filtroContrasena" class="form-select" value="@(contraseña ?? "")"
                        @onchange='e => CambiarFiltro(ref contraseña, "contrasena", e.Value?.ToString())'>
                    <option value="">Todas</option>
                    <option value="@ContraseñaPropia">Propia</option>
                    <option value="@ContraseñaTemporal">Temporal</option>
                </select>
            </div>
        </TarjetaFiltros>

        @if (usuarios == null)
        {
            <p><em>Cargando...</em></p>
        }
        else if (Filtrados!.Count == 0)
        {
            <p class="text-muted">No hay usuarios que coincidan con los filtros.</p>
        }
        else
        {
            <div class="tabla-tarjeta">
                <table class="table table-hover align-middle">
                    <thead>
                        <tr>
                            <th>Email</th>
                            <th>Rol</th>
                            <th class="numero">Apiarios</th>
                            <th>Contraseña</th>
                            <th class="col-acciones"><span class="visually-hidden">Acciones</span></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var usuario in Filtrados)
                        {
                            var esYo = usuario.Email == emailActual;
                            <tr>
                                <td>
                                    @usuario.Email
                                    @if (esYo)
                                    {
                                        <span class="texto-suave ms-1">(vos)</span>
                                    }
                                </td>
                                <td>
                                    @if (usuario.EsAdministrador)
                                    {
                                        <span class="etiqueta etiqueta-miel">Administradora</span>
                                    }
                                    else
                                    {
                                        <span class="etiqueta etiqueta-neutra">Apicultor</span>
                                    }
                                </td>
                                <td class="numero">@usuario.CantidadApiarios</td>
                                <td>
                                    @if (usuario.TieneContraseñaTemporal)
                                    {
                                        <span class="etiqueta etiqueta-miel" title="Todavía no ingresó para elegir una propia">Temporal</span>
                                    }
                                    else
                                    {
                                        <span class="etiqueta etiqueta-sana">Propia</span>
                                    }
                                </td>
                                <td class="col-acciones">
                                    @if (!esYo)
                                    {
                                        <button type="button" class="btn-texto" disabled="@(procesando is not null)"
                                                aria-label="Restablecer la contraseña de @usuario.Email"
                                                @onclick="() => Restablecer(usuario)">
                                            <i class="bi bi-arrow-counterclockwise" aria-hidden="true"></i>
                                            @(procesando == usuario.Id ? "Restableciendo..." : "Restablecer contraseña")
                                        </button>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
    </Authorized>
    <NotAuthorized>
        <MensajeError Mensaje="No tenés permiso para ver esta pantalla." />
        <a href="/" class="btn btn-cancelar">Volver</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    List<UsuarioGrillaDto>? usuarios = null;
    ContraseñaTemporalDto? temporal;
    string? mensajeError;
    string? emailActual;
    string? procesando;
    bool copiada;

    // Filtros (se leen de la URL al entrar).
    private const string RolAdministradora = "administradora";
    private const string RolApicultor = "apicultor";
    private const string ContraseñaPropia = "propia";
    private const string ContraseñaTemporal = "temporal";
    [SupplyParameterFromQuery(Name = "email")] public string? ParamEmail { get; set; }
    [SupplyParameterFromQuery(Name = "rol")] public string? ParamRol { get; set; }
    [SupplyParameterFromQuery(Name = "contrasena")] public string? ParamContraseña { get; set; }
    string? email;
    string? rol;
    string? contraseña;

    [CascadingParameter]
    Task<AuthenticationState>? Autenticacion { get; set; }

    bool HayFiltros => !string.IsNullOrWhiteSpace(email) || !string.IsNullOrEmpty(rol) || !string.IsNullOrEmpty(contraseña);

    List<UsuarioGrillaDto>? Filtrados => usuarios?
        .Where(u => FiltrosLista.Contiene(u.Email, email))
        .Where(u => rol switch
        {
            RolAdministradora => u.EsAdministrador,
            RolApicultor => !u.EsAdministrador,
            _ => true
        })
        .Where(u => contraseña switch
        {
            ContraseñaPropia => !u.TieneContraseñaTemporal,
            ContraseñaTemporal => u.TieneContraseñaTemporal,
            _ => true
        })
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        email = ParamEmail;
        // Un valor desconocido en la URL se ignora.
        rol = ParamRol is RolAdministradora or RolApicultor ? ParamRol : null;
        contraseña = ParamContraseña is ContraseñaPropia or ContraseñaTemporal ? ParamContraseña : null;

        if (!await Autenticacion.EsAdministradorAsync())
            return;

        emailActual = (await Autenticacion!).User.Identity?.Name;
        await CargarUsuarios();
    }

    void CambiarFiltro(ref string? campo, string parametro, string? valor)
    {
        campo = string.IsNullOrEmpty(valor) ? null : valor;
        _navegationmanager.CambiarParametro(parametro, valor);
    }

    void LimpiarFiltros()
    {
        email = rol = contraseña = null;
        _navegationmanager.NavigateTo("/usuarios", replace: true);
    }

    async Task Restablecer(UsuarioGrillaDto usuario)
    {
        if (!await JS.InvokeAsync<bool>("confirm",
                $"¿Restablecer la contraseña de {usuario.Email}? La contraseña que usa ahora va a dejar de funcionar."))
            return;

        mensajeError = null;
        temporal = null;
        copiada = false;
        procesando = usuario.Id;
        try
        {
            temporal = await _servicio.RestablecerContraseña(usuario.Id);
            await CargarUsuarios();
        }
        catch (HttpRequestException ex)
        {
            mensajeError = ex.Message;
        }
        finally
        {
            procesando = null;
        }
    }

    async Task Copiar()
    {
        if (temporal is null)
            return;
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", temporal.Contraseña);
            copiada = true;
        }
        catch (JSException)
        {
            mensajeError = "No se pudo copiar. Seleccioná la contraseña y copiala a mano.";
        }
    }

    // La contraseña solo vive en esta pantalla: al tocar "Listo" (o salir) ya no se puede volver a ver.
    void Ocultar()
    {
        temporal = null;
        copiada = false;
    }

    async Task CargarUsuarios()
    {
        usuarios = await _servicio.ObtenerGrillaUsuarios();
    }
}
