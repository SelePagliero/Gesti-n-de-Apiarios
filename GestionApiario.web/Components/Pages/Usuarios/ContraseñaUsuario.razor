@page "/usuarios/{Id}/contrasena"
@inject IApiariosServicio _servicio
@inject NavigationManager _navegationmanager

<PageTitle>Cambiar contraseña de un apicultor</PageTitle>

<EncabezadoPagina Titulo="Cambiar contraseña" Descripcion="Para un apicultor que olvidó la suya. Después pasásela por un medio seguro." />

@* Solo la Administradora; la API también lo exige (responde 403 a los apicultores). *@
<AuthorizeView Roles="@RolesUsuario.Administrador" Context="autorizacion">
    <Authorized>
        @if (usuario is null)
        {
            @if (mensajeError is null)
            {
                <p><em>Cargando...</em></p>
            }
            else
            {
                <MensajeError Mensaje="@mensajeError" />
                <a href="/usuarios" class="btn btn-cancelar">Volver</a>
            }
        }
        else
        {
            <MensajeError Mensaje="@mensajeError" />

            <EditForm Model="Cambio" OnValidSubmit="Guardar" class="formulario-angosto">
                <DataAnnotationsValidator />
                <dl class="detalle mb-3">
                    <dt>Apicultor</dt>
                    <dd id="usuario-email">@usuario.Email</dd>
                </dl>
                <div class="mb-3">
                    <label for="contrasena-nueva" class="form-label">Contraseña nueva</label>
                    <InputText id="contrasena-nueva" type="password" class="form-control" @bind-Value="Cambio.ContraseñaNueva" autocomplete="new-password" aria-describedby="reglas-contrasena" />
                    <div id="reglas-contrasena" class="form-text">Al menos 8 caracteres, con una mayúscula, una minúscula y un número.</div>
                    <ValidationMessage For="() => Cambio.ContraseñaNueva" />
                </div>
                <div class="mb-3">
                    <label for="contrasena-repetida" class="form-label">Repetí la contraseña nueva</label>
                    <InputText id="contrasena-repetida" type="password" class="form-control" @bind-Value="Cambio.ConfirmacionContraseña" autocomplete="new-password" />
                    <ValidationMessage For="() => Cambio.ConfirmacionContraseña" />
                </div>
                <div class="acciones-formulario">
                    <button type="submit" class="btn btn-guardar" disabled="@procesando">
                        @(procesando ? "Guardando..." : "Guardar")
                    </button>
                    <a href="/usuarios" class="btn btn-cancelar">Cancelar</a>
                </div>
            </EditForm>
        }
    </Authorized>
    <NotAuthorized>
        <MensajeError Mensaje="No tenés permiso para ver esta pantalla." />
        <a href="/" class="btn btn-cancelar">Volver</a>
    </NotAuthorized>
</AuthorizeView>

@code {
    [Parameter]
    public string Id { get; set; } = string.Empty;

    [CascadingParameter]
    Task<AuthenticationState>? Autenticacion { get; set; }

    UsuarioGrillaDto? usuario;
    ContraseñaNuevaDto Cambio { get; set; } = new();
    string? mensajeError;
    bool procesando;

    protected override async Task OnParametersSetAsync()
    {
        if (!await Autenticacion.EsAdministradorAsync())
            return;

        var encontrado = (await _servicio.ObtenerGrillaUsuarios()).FirstOrDefault(u => u.Id == Id);
        if (encontrado is null)
            mensajeError = "El usuario no existe.";
        else if (encontrado.EsAdministrador)
            mensajeError = "Solo se puede cambiar la contraseña de un apicultor. La tuya la cambiás desde \"Cambiar contraseña\" en el encabezado.";
        else
            usuario = encontrado;
    }

    async Task Guardar()
    {
        mensajeError = null;
        procesando = true;
        try
        {
            await _servicio.CambiarContraseñaDeUsuario(Id, Cambio);
        }
        catch (HttpRequestException ex)
        {
            mensajeError = ex.Message;
            return;
        }
        finally
        {
            procesando = false;
        }

        _navegationmanager.NavigateTo($"/usuarios?cambiada={Uri.EscapeDataString(usuario!.Email)}");
    }
}
