@page "/crear-apiario"
@page "/actualizar-apiario/{codigo:int}"
@page "/ver-apiario/{codigo:int}"
@inject IApiariosServicio _servicio
@inject NavigationManager _navegationmanager

@{
    bool EsSoloLectura = _navegationmanager.Uri.Contains("/ver-apiario", StringComparison.OrdinalIgnoreCase);
}

<PageTitle>Apiario</PageTitle>

<EncabezadoPagina Titulo="@(EsSoloLectura ? "Ver apiario" : Codigo is null ? "Nuevo apiario" : "Editar apiario")" />

<MensajeError Mensaje="@mensajeError" />

@if (EsSoloLectura)
{
    @* Pantalla de Ver: los datos en dos columnas (etiqueta y valor). *@
    <div class="card tarjeta-detalle">
        <div class="card-body">
            <dl class="detalle">
                @if (esAdministrador)
                {
                    <dt>Apicultor</dt>
                    <dd id="detalle-apicultor">@ValorOGuion(apicultor)</dd>
                }
                <dt>Nombre</dt>
                <dd id="detalle-nombre">@ValorOGuion(Apiario.Nombre)</dd>
                <dt>Empresa</dt>
                <dd>@ValorOGuion(Apiario.Empresa)</dd>
                <dt>Latitud</dt>
                <dd>@ValorOGuion(Apiario.Latitud)</dd>
                <dt>Longitud</dt>
                <dd>@ValorOGuion(Apiario.Longitud)</dd>
            </dl>
            <div class="acciones-formulario">
                <a href="/actualizar-apiario/@Codigo" class="btn btn-guardar"><i class="bi bi-pencil" aria-hidden="true"></i>Editar</a>
                <a href="/apiarios" class="btn btn-cancelar">Volver</a>
            </div>
        </div>
    </div>
}
else
{
    <EditForm Model="Apiario" OnValidSubmit="HandleSubmit">
        <DataAnnotationsValidator />
        @if (esAdministrador)
        {
            @* Solo la Administradora elige el dueño; sus controles pasan con el apiario. La API también lo exige. *@
            <div class="mb-3">
                <label for="dueño" class="form-label">Dueño (apicultor)</label>
                <InputSelect id="dueño" class="form-select" @bind-Value="Apiario.UsuarioId">
                    @foreach (var usuario in usuarios)
                    {
                        <option value="@usuario.Id">@usuario.Email</option>
                    }
                </InputSelect>
                @if (Codigo is not null && Apiario.UsuarioId != dueñoOriginal)
                {
                    <small class="form-text text-warning">Al guardar, el apiario y todos sus controles pasan al nuevo dueño.</small>
                }
            </div>
        }
        <div class="mb-3">
            <label for="nombre" class="form-label">Nombre</label>
            <InputText class="form-control" id="nombre" @bind-Value="Apiario.Nombre" />
            <ValidationMessage For="() => Apiario.Nombre" />
        </div>
        <div class="mb-3">
            <label for="empresa" class="form-label">Empresa</label>
            <InputText class="form-control" id="empresa" @bind-Value="Apiario.Empresa" />
            <ValidationMessage For="() => Apiario.Empresa" />
        </div>
        <div class="row">
            <div class="col-12 col-md-6 mb-3">
                <label for="latitud" class="form-label">Latitud</label>
                <InputText class="form-control" id="latitud" @bind-Value="Apiario.Latitud" />
                <ValidationMessage For="() => Apiario.Latitud" />
            </div>
            <div class="col-12 col-md-6 mb-3">
                <label for="longitud" class="form-label">Longitud</label>
                <InputText class="form-control" id="longitud" @bind-Value="Apiario.Longitud" />
                <ValidationMessage For="() => Apiario.Longitud" />
            </div>
        </div>
        <div class="acciones-formulario">
            <button type="submit" class="btn btn-guardar">Guardar</button>
            <a href="/apiarios" class="btn btn-cancelar">Cancelar</a>
        </div>
    </EditForm>
}

@code {
    [Parameter]
    public int? Codigo { get; set; }
    public ApiarioDto Apiario { get; set; } = new ApiarioDto();
    string? mensajeError;
    bool esAdministrador;
    List<UsuarioDto> usuarios = new();
    string? dueñoOriginal;
    string? apicultor;

    private static string ValorOGuion(string? valor) => string.IsNullOrWhiteSpace(valor) ? "—" : valor;

    [CascadingParameter]
    Task<AuthenticationState>? Autenticacion { get; set; }

    protected override async Task OnInitializedAsync()
    {
        esAdministrador = await Autenticacion.EsAdministradorAsync();
        if (esAdministrador)
            usuarios = await _servicio.ObtenerUsuarios();
    }

    protected async Task HandleSubmit()
    {
        mensajeError = null;
        try
        {
            if (Codigo is null)
            {
                await _servicio.CrearApiario(Apiario);
            }
            else
            {
                await _servicio.ModificarApiario(Codigo.Value, Apiario);
            }
        }
        catch (HttpRequestException ex)
        {
            mensajeError = ex.Message;
            return;
        }

        _navegationmanager.NavigateTo("/apiarios");
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Codigo.HasValue)
        {
            var apiarioDetalle = await _servicio.ObtenerApiario(Codigo.Value);
            Apiario = new()
            {
                Nombre = apiarioDetalle.Nombre,
                Empresa = apiarioDetalle.Empresa,
                Longitud = apiarioDetalle.Longitud,
                Latitud = apiarioDetalle.Latitud,
                UsuarioId = apiarioDetalle.UsuarioId
            };
            dueñoOriginal = apiarioDetalle.UsuarioId;
            apicultor = apiarioDetalle.Apicultor;
        }
        else if (esAdministrador && string.IsNullOrEmpty(Apiario.UsuarioId))
        {
            // Al crear, la Administradora queda como dueña salvo que elija otro apicultor.
            var email = (await Autenticacion!).User.Identity?.Name;
            Apiario.UsuarioId = usuarios.FirstOrDefault(u => u.Email == email)?.Id;
        }
    }
}
