@page "/contrasena-temporal"
@layout CuentaLayout
@inject CuentaServicio _cuenta
@inject EstadoAutenticacion _estado
@inject NavigationManager _navegationmanager

@* Cambio obligatorio: quien ingresó con una contraseña temporal no puede usar el sistema hasta elegir una propia.
   La API también lo exige: con la contraseña temporal responde 403 a todo lo demás. *@

<PageTitle>Elegí una contraseña nueva</PageTitle>

@if (email is not null)
{
    <h5 class="mb-2">Elegí una contraseña nueva</h5>
    <p class="cuenta-aviso">
        Ingresaste como <strong>@email</strong> con una contraseña temporal. Antes de seguir, elegí una contraseña propia.
    </p>

    <FormularioCambioContraseña EtiquetaActual="Contraseña temporal" AnchoCompleto="true" AlCambiar="IrAlInicio" />

    <p class="mt-3 mb-0 text-center">
        <button type="button" class="btn btn-link p-0" @onclick="CerrarSesion">Cerrar sesión</button>
    </p>
}

@code {
    private string? email;

    protected override async Task OnInitializedAsync()
    {
        var sesion = await _estado.ObtenerSesionAsync();
        if (sesion is null)
        {
            _navegationmanager.NavigateTo("login");
            return;
        }
        if (!sesion.DebeCambiarContraseña)
        {
            IrAlInicio();
            return;
        }
        email = sesion.Email;
    }

    private void IrAlInicio() => _navegationmanager.NavigateTo("");

    private async Task CerrarSesion()
    {
        await _cuenta.CerrarSesionAsync();
        _navegationmanager.NavigateTo("login");
    }
}
