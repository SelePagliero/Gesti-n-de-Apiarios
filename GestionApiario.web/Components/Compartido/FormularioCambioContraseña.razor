@* Formulario para cambiar la propia contraseña: la actual y la nueva dos veces.
   Lo usan la pantalla "Cambiar contraseña" y la del cambio obligatorio después de una contraseña temporal. *@
@inject CuentaServicio _cuenta

<MensajeError Mensaje="@mensajeError" />

<EditForm Model="Cambio" OnValidSubmit="Cambiar" class="@ClaseFormulario">
    <DataAnnotationsValidator />
    <div class="mb-3">
        <label for="contrasena-actual" class="form-label">@EtiquetaActual</label>
        <InputText id="contrasena-actual" type="password" class="form-control" @bind-Value="Cambio.ContraseñaActual" autocomplete="current-password" />
        <ValidationMessage For="() => Cambio.ContraseñaActual" />
    </div>
    <div class="mb-3">
        <label for="contrasena-nueva" class="form-label">Contraseña nueva</label>
        <InputText id="contrasena-nueva" type="password" class="form-control" @bind-Value="Cambio.ContraseñaNueva" autocomplete="new-password" aria-describedby="reglas-contrasena" />
        <div id="reglas-contrasena" class="form-text">Al menos 8 caracteres, con una mayúscula, una minúscula y un número.</div>
        <ValidationMessage For="() => Cambio.ContraseñaNueva" />
    </div>
    <div class="mb-3">
        <label for="contrasena-repetida" class="form-label">Repetí la contraseña nueva</label>
        <InputText id="contrasena-repetida" type="password" class="form-control" @bind-Value="Cambio.ConfirmacionContraseña" autocomplete="new-password" />
        <ValidationMessage For="() => Cambio.ConfirmacionContraseña" />
    </div>
    @ChildContent
    <div class="@ClaseAcciones">
        <button type="submit" class="btn btn-guardar @ClaseBoton" disabled="@procesando">
            @(procesando ? "Guardando..." : "Cambiar contraseña")
        </button>
        @Acciones
    </div>
</EditForm>

@code {
    [Parameter]
    public string EtiquetaActual { get; set; } = "Contraseña actual";

    // En la tarjeta de ingreso el botón ocupa todo el ancho y no lleva la línea separadora.
    [Parameter]
    public bool AnchoCompleto { get; set; }

    // Contenido opcional antes de los botones y botones extra (por ejemplo "Cancelar").
    [Parameter]
    public RenderFragment? ChildContent { get; set; }

    [Parameter]
    public RenderFragment? Acciones { get; set; }

    [Parameter]
    public EventCallback AlCambiar { get; set; }

    private CambioContraseñaDto Cambio { get; set; } = new();
    private string? mensajeError;
    private bool procesando;

    private string? ClaseFormulario => AnchoCompleto ? null : "formulario-angosto";
    private string ClaseAcciones => AnchoCompleto ? "mt-2" : "acciones-formulario";
    private string? ClaseBoton => AnchoCompleto ? "w-100" : null;

    private async Task Cambiar()
    {
        procesando = true;
        mensajeError = await _cuenta.CambiarContraseñaAsync(Cambio);
        procesando = false;

        if (mensajeError is null)
        {
            Cambio = new();
            await AlCambiar.InvokeAsync();
        }
    }
}
